{
  "installCommand": "npm ci --prefix server && npm ci --prefix client",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 1 * * 1"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
